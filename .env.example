# ==============================================================================
# ArcCross Environment Variables
# ==============================================================================
# CURRENT DEPLOYMENT STATUS:
# No environment variables are required to deploy and run ArcCross on Vercel
# today. The application is currently a static Vite + React frontend.
#
# Copy this file to ".env.local" (never commit real secrets) if you configure
# optional overrides or add a backend server in the future.
# ==============================================================================

# --- Optional Frontend Configuration (Vite exposes VITE_* variables to client) ---
# Display name override (defaults to "ArcCross")
# VITE_APP_NAME=ArcCross

# Base URL for future backend API requests.
# Leave unset (defaults to "/api") when frontend and Vercel API routes share a domain,
# or set to your external backend origin (e.g., https://api.example.com) later.
# VITE_API_BASE_URL=/api

# Local development only: proxy /api/* requests from Vite (port 5173) to a local backend server.
# VITE_DEV_API_PROXY=http://localhost:3001

# --- Future Backend Server Variables (for when you add an API/server later) ---
# Never prefix backend secrets with VITE_ (VITE_* values are bundled into browser code).
# PORT=3001
# NODE_ENV=production
# DATABASE_URL=postgresql://username:password@hostname:5432/arccross
# AUTH_SECRET=replace-with-a-long-random-secret
